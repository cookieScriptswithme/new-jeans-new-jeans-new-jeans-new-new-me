local function applyFog()
    local atmos = Lighting:FindFirstChildOfClass("Atmosphere")
    if atmos then atmos.Density = 0 end
    if FogConfig.Enabled then
        Lighting.FogColor = FogConfig.Color
        Lighting.FogStart = FogConfig.StartDistance
        Lighting.FogEnd = FogConfig.EndDistance
    else
        Lighting.FogStart = 0; Lighting.FogEnd = 100000
    end
end

local function parseHex(hex)
    hex = hex:gsub("#", "")
    if #hex == 6 then
        local r = tonumber(hex:sub(1, 2), 16)
        local g = tonumber(hex:sub(3, 4), 16)
        local b = tonumber(hex:sub(5, 6), 16)
        if r and g and b then return Color3.fromRGB(r, g, b) end
    end
    return nil
end

local function updateChams(character, enable)
    if not character then return end
    local h = character:FindFirstChild("CCHubHighlight")
    if enable and HitboxConfig.ChamsEnabled then
        if not h then
            h = Instance.new("Highlight"); h.Name = "CCHubHighlight"; h.Adornee = character
            h.FillColor = HitboxConfig.ChamsColor; h.OutlineColor = HitboxConfig.ChamsColor
            h.FillTransparency = 0.5; h.OutlineTransparency = 0; h.Parent = character
        end
        h.Enabled = true
    else
        if h then h.Enabled = false end
    end
end

